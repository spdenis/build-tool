<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <!-- ${sys:LOG_FILE} is the base path (no extension) resolved from the
         logging.file.name property, set in Main.main() before Spring Boot starts,
         to the directory containing the repos.json argument. Defaults to "multibuild"
         (relative to the process working directory) when no override is set. -->
    <Properties>
        <Property name="LOG_BASE">${sys:LOG_FILE:-multibuild}</Property>
        <Property name="CONSOLE_LOG_PATTERN">%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %highlight{%5p} %style{%pid}{magenta} --- [%15.15t] %style{%-40.40c{1.}}{cyan} : %m%n%xwEx</Property>
        <Property name="FILE_LOG_PATTERN">%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p %pid --- [%t] %-40.40c{1.} : %m%n%xwEx</Property>
    </Properties>

    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout pattern="${CONSOLE_LOG_PATTERN}"/>
        </Console>

        <!--
            OnStartupTriggeringPolicy rolls the active file once per JVM run if it
            predates this run's startup — a built-in Log4j2 feature purpose-built for
            "start every run with a fresh file", with no custom Java trigger needed
            (Logback has no equivalent; see logback-spring.xml's git history for the
            issues hit trying to fake this with a custom TriggeringPolicy there).
            SizeBasedTriggeringPolicy additionally rotates mid-run past 50MB.
        -->
        <RollingFile name="FILE"
                     fileName="${LOG_BASE}.log"
                     filePattern="${LOG_BASE}.%d{yyyy-MM-dd-HH-mm-ss}.%i.log.gz">
            <PatternLayout pattern="${FILE_LOG_PATTERN}"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="50MB"/>
            </Policies>
            <DefaultRolloverStrategy max="999999"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="FILE"/>
        </Root>
    </Loggers>
</Configuration>
